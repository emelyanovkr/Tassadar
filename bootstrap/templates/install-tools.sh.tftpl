#!/usr/bin/env bash
set -euo pipefail

install -d -m 0755 /etc/apt/keyrings
curl --fail --silent --show-error --location https://get.opentofu.org/opentofu.gpg \
  --output /etc/apt/keyrings/opentofu.gpg
curl --fail --silent --show-error --location https://packages.opentofu.org/opentofu/tofu/gpgkey \
  | gpg --no-tty --batch --yes --dearmor --output /etc/apt/keyrings/opentofu-repo.gpg
chmod 0644 /etc/apt/keyrings/opentofu.gpg /etc/apt/keyrings/opentofu-repo.gpg

cat > /etc/apt/sources.list.d/opentofu.list <<'REPOSITORY'
deb [signed-by=/etc/apt/keyrings/opentofu.gpg,/etc/apt/keyrings/opentofu-repo.gpg] https://packages.opentofu.org/opentofu/tofu/any/ any main
REPOSITORY

apt-get update
DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends 'tofu=${opentofu_version}'
python3 -m venv /opt/tassadar/ansible
/opt/tassadar/ansible/bin/pip install 'ansible-core==${ansible_core_version}'
for executable in ansible ansible-playbook ansible-vault; do
  ln -sfn "/opt/tassadar/ansible/bin/$executable" "/usr/local/bin/$executable"
done

tofu version
ansible-playbook --version
install -d -m 0755 /var/lib/tassadar
touch /var/lib/tassadar/bootstrap-complete
